{
    "manifest_version": 3,
    "name": "Email Assistant",
    "version": "1.0.0",
    "description": "AI-powered email management and recommendations",
    "permissions": [
        "storage",
        "activeTab",
        "tabs",
        "identity"
    ],
    "host_permissions": [
        "https://mail.google.com/*",
        "http://localhost:8000/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Email Assistant"
    },
    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*",
                "https://outlook.live.com/*"
            ],
            "js": ["content.js"]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}